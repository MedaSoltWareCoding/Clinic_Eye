<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Medical"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" x:Class="Medical.MainWindow"
        mc:Ignorable="d"
        Title="MainWindow" Width="742" Height="649"
        WindowStartupLocation="CenterScreen"
       
        MinWidth="800"
        MinHeight="600" Margin="0,0,0,7">
    <Window.Resources>

        <!-- Style for Rounded TextBox -->
        <Style x:Key="RoundedTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="5" Padding="5">
                            <ScrollViewer Margin="0" x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="#f9f9f9"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="BorderBrush" Value="#dcdcdc"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Style for Rounded Button -->
        <Style x:Key="RoundedButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" 
                            CornerRadius="5"
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            Effect="{DynamicResource ShadowEffect}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="#0078D7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <!-- Shadow Effect -->
        <DropShadowEffect x:Key="ShadowEffect" BlurRadius="10" ShadowDepth="3" Color="#888"/>
    </Window.Resources>





    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="26*"/>
            <ColumnDefinition Width="49*"/>
            <ColumnDefinition Width="110*"/>
            <ColumnDefinition Width="8*"/>
            <ColumnDefinition Width="18*"/>
            <ColumnDefinition Width="83*"/>
            <ColumnDefinition Width="818*"/>
            <ColumnDefinition Width="0*"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Grid.Column="7" Grid.RowSpan="1" Margin="109,0,0,0" Grid.ColumnSpan="2">
            <StackPanel Background="#2D2D30" Grid.Column="7" RenderTransformOrigin="0.769,0.539" Width="90" Margin="0,-5,0,-1" HorizontalAlignment="Right" Grid.RowSpan="1">
                <StackPanel.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform Angle="0.058"/>
                        <TranslateTransform X="0.186" Y="-0.338"/>
                    </TransformGroup>
                </StackPanel.RenderTransform>
                <TextBlock Text="عيادة العيون" FontWeight="Bold" Foreground="White" TextAlignment="Center" Width="88" HorizontalAlignment="Right" FontSize="15" Margin="0,10,0,50"/>

                <Button Height="59" Background="#0078D7" Foreground="White" FontSize="16" Tag="المرضى" Click="OpenTab" Width="64" Margin="0,0,0,10" HorizontalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}" BorderBrush="#0078D7" BorderThickness="1" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Source="images/patient.png" Width="40" Height="30" HorizontalAlignment="Center" />
                        <TextBlock Text="المرضى" />
                    </StackPanel>
                </Button>

                <Button Height="59" Background="#0078D7" Foreground="White" FontSize="16"  Tag="المواعيد" Click="OpenTab" Width="64" Margin="0,0,0,10" HorizontalAlignment="Center" >
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}" BorderBrush="#0078D7" BorderThickness="1" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Source="images/appointment.png" Width="40" Height="30"/>
                        <TextBlock Text="المواعيد"/>

                    </StackPanel>
                </Button>
                <Button Height="59" Background="#0078D7" Foreground="White" FontSize="16"  Tag="الأطباء" Click="OpenTab" Width="64" Margin="0,0,0,10" HorizontalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}" BorderBrush="#0078D7" BorderThickness="1" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Source="images/doctor.png" Width="40" Height="30"/>
                        <TextBlock Text="الأطباء"/>
                    </StackPanel>
                </Button>

                <Button Height="59" Background="#0078D7" Foreground="White" FontSize="16" Tag="الأدوية" Click="OpenTab" Width="64" RenderTransformOrigin="0.516,0.559" Margin="0,0,0,10" HorizontalAlignment="Center" >
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}" BorderBrush="#0078D7" BorderThickness="1" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Source="images/medicine.png" Width="40" Height="30"/>
                        <TextBlock Text="الأدوية"/>
                    </StackPanel>
                </Button>
                <Button Height="59" Background="#0078D7" Foreground="White" FontSize="16" Tag="الفحوصات" Click="OpenTab" Width="64" HorizontalAlignment="Center" >
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}" BorderBrush="#0078D7" BorderThickness="1" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,0,-9">
                        <Image Source="images/examination.png" Width="40" Height="30"/>
                        <TextBlock Text="الفحوصات" FontSize="13"/>
                    </StackPanel>
                </Button>
                <Button  Height="59" Margin="0,10,0,0" Background="#0078D7" Foreground="White" FontSize="16" Tag="التقارير" Click="OpenTab" Width="64" HorizontalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}" BorderBrush="#0078D7" BorderThickness="1" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Source="images/application.png" Width="40" Height="30"/>
                        <TextBlock Text="التقارير"/>
                    </StackPanel>
                </Button>
                <Button  Height="59" Background="#0078D7" Foreground="White" FontSize="16" Tag="الفواتير" Click="OpenTab" Width="64" Margin="0,11,0,0" HorizontalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}" BorderBrush="#0078D7" BorderThickness="1" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Source="images/bill.png" Width="40" Height="30"/>
                        <TextBlock Text="الفواتير"/>
                    </StackPanel>
                </Button>
                <Button Height="59" Background="#0078D7" Foreground="White" FontSize="16" Tag="النظارات" Click="OpenTab" Width="64" Margin="0,10,0,0" HorizontalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}" BorderBrush="#0078D7" BorderThickness="1" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Source="images/sunglasses.png" Width="40" Height="30"/>
                        <TextBlock Text="النظارات"/>
                    </StackPanel>
                </Button>
                <Button Height="59" Margin="0,10,0,0" Background="#0078D7" Foreground="White" Tag="التكاليف" Click="OpenTab" Width="64" HorizontalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}" BorderBrush="#0078D7" BorderThickness="1" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>

                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Source="images/budget.png" Width="40" Height="30"/>
                        <TextBlock Text="التكاليف" RenderTransformOrigin="0.589,2.563"/>
                    </StackPanel>
                </Button>


            </StackPanel>
        </ScrollViewer>



        <!-- Main Content Area -->
        <Grid Grid.Column="0" Grid.ColumnSpan="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="65*"/>
                <ColumnDefinition Width="39*"/>
                <ColumnDefinition Width="59*"/>
                <ColumnDefinition Width="55*"/>
                <ColumnDefinition Width="52*"/>
                <ColumnDefinition Width="1192*"/>
            </Grid.ColumnDefinitions>
            <TabControl x:Name="MainTabControl" TabStripPlacement="Top" Background="#F3F3F3" Margin="0,-40,-111,0" RenderTransformOrigin="0.392,0.509" Grid.ColumnSpan="7">
                <!-- Patients Tab -->
                <TabItem Header="المرضى">
                    <Grid Background="White" Margin="0,0,-3,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="77*"/>
                            <ColumnDefinition Width="11*"/>
                            <ColumnDefinition Width="645*"/>
                            <ColumnDefinition Width="488*"/>
                        </Grid.ColumnDefinitions>

                        <!-- DataGrid on the Left -->
                        <DataGrid x:Name="PatientsDataGrid" 
                  BorderBrush="#dcdcdc" BorderThickness="1"   SelectedItem="{Binding SelectedPatient}"
                  RowBackground="White" AlternatingRowBackground="#f5f5f5"
                  ColumnHeaderHeight="30" RowHeight="40" 
                  GridLinesVisibility="None" AutoGenerateColumns="False" ItemsSource="{Binding Patients}" DataContext="{Binding pat_viewModel}"
                  SelectionMode="Single" AlternationCount="1" SelectionChanged="PatientsDataGrid_SelectionChanged" FrozenColumnCount="80" ColumnWidth="5" Background="#FFF9FDFF" IsSynchronizedWithCurrentItem="True" Margin="5,116,10,10" Grid.ColumnSpan="3">
                            <DataGrid.Effect>
                                <DropShadowEffect Color="#FFCCCCCC" BlurRadius="17" Direction="700" ShadowDepth="5"/>
                            </DataGrid.Effect>
                            <DataGrid.Columns>







                                <DataGridTextColumn Header="رقم الهاتف" Binding="{Binding Phone}" Width="*"/>
                                <DataGridTextColumn Header="العنوان" Binding="{Binding Address}" Width="*"/>
                                <DataGridTextColumn Header="المكان" Binding="{Binding City}" Width="*"/>
                                <DataGridTextColumn Header="تاريخ الإزدياد" Binding="{Binding Birthday, StringFormat=yyyy-MM-dd}" Width="*"/>
                                <DataGridTextColumn Header="الجنس" Binding="{Binding Gender}" Width="*"/>
                                <DataGridTextColumn Header="العمر" Binding="{Binding Age}" Width="*"/>
                                <DataGridTextColumn Header="اللقب" Binding="{Binding FamilyName}" Width="*"/>
                                <DataGridTextColumn Header="الإسم" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="رقم" Binding="{Binding Id}" Width="*"/>

                            </DataGrid.Columns>
                        </DataGrid>

                        <Viewbox Stretch="Uniform" Margin="0,116,14,-1" OpacityMask="White" Grid.Column="3" HorizontalAlignment="Right">
                            <!-- Form on the Right -->
                            <StackPanel HorizontalAlignment="Center" Orientation="Vertical" VerticalAlignment="Center">
                                <StackPanel x:Name="stackPanel" Height="1016" Width="651" Background="#FFD7E7F3" ClipToBounds="{Binding Background, ElementName=stackPanel}" Margin="0,0,10,20" >

                                    <TextBlock Text="إضافة مريض" FontSize="40" FontWeight="Bold" Margin="0,10,0,20" 
                                        Foreground="#333" HorizontalAlignment="Center" TextAlignment="Center"/>

                                    <!-- Name -->
                                    <TextBlock Text="الإسم" FontSize="20" Foreground="#666" Margin="0,0,10,5" 
                                        HorizontalAlignment="Right" TextAlignment="Right"/>
                                    <TextBox x:Name="NameTextBox" HorizontalAlignment="Right" Height="40" Margin="20,0,10,15" 
                                        Style="{StaticResource RoundedTextBoxStyle}" FontSize="20" TextAlignment="Right" Width="500" Background="#FFF9F9F9"/>

                                    <!-- Family Name -->
                                    <TextBlock Text="اللقب" FontSize="20" Foreground="#666" Margin="0,0,10,5" 
                                        HorizontalAlignment="Right" TextAlignment="Right"/>
                                    <TextBox x:Name="FamilyNameTextBox" Height="40" Margin="20,0,10,15" 
                                        Style="{StaticResource RoundedTextBoxStyle}" FontSize="20" TextAlignment="Right" Width="500" HorizontalAlignment="Right"/>

                                    <!-- Age -->
                                    <TextBlock Text="العمر" FontSize="20" Foreground="#666" Margin="0,0,10,5" 
                                        HorizontalAlignment="Right" TextAlignment="Right"/>
                                    <TextBox x:Name="AgeTextBox" HorizontalAlignment="Right" Height="40" Margin="20,0,10,15" 
                                        Style="{StaticResource RoundedTextBoxStyle}" FontSize="20" TextAlignment="Right" Width="500"/>

                                    <!-- Gender -->
                                    <TextBlock Text="الجنس" FontSize="20" Foreground="#666" Margin="0,0,10,5" 
                                        HorizontalAlignment="Right" TextAlignment="Right"/>
                                    <ComboBox x:Name="GenderComboBox" HorizontalAlignment="Right" Height="40" Margin="20,0,10,15" Width="494" FontSize="20">
                                        <ComboBoxItem Content="ذكر"/>
                                        <ComboBoxItem Content="انثى"/>
                                    </ComboBox>

                                    <!-- Date of Birth -->
                                    <TextBlock Text="تاريخ الإزدياد" FontSize="20" Foreground="#666" Margin="0,0,10,5" 
                                        HorizontalAlignment="Right" TextAlignment="Right"/>
                                    <DatePicker x:Name="DateOfBirthPicker" HorizontalAlignment="Right" Height="40" Margin="20,0,10,15" Width="492" FontSize="20"/>

                                    <!-- City -->
                                    <TextBlock Text="المكان" FontSize="20" Foreground="#666" Margin="0,0,10,5" 
                                        HorizontalAlignment="Right" TextAlignment="Right"/>
                                    <TextBox x:Name="CityTextBox" HorizontalAlignment="Right" Height="40" Margin="20,0,10,15" 
                                        Style="{StaticResource RoundedTextBoxStyle}" FontSize="20" TextAlignment="Right" Width="500"/>

                                    <!-- Address -->
                                    <TextBlock Text="العنوان" FontSize="20" Foreground="#666" Margin="0,0,10,5" 
                                        HorizontalAlignment="Right" TextAlignment="Right"/>
                                    <TextBox x:Name="AddressTextBox" HorizontalAlignment="Right" Height="40" Margin="20,0,10,15" 
                                        Style="{StaticResource RoundedTextBoxStyle}" FontSize="20" TextAlignment="Right" Width="500"/>

                                    <!-- Phone Number -->
                                    <TextBlock Text="رقم الهاتف" FontSize="20" Foreground="#666" Margin="0,0,10,5" 
                                        HorizontalAlignment="Right" TextAlignment="Right"/>
                                    <TextBox x:Name="PhoneNumberTextBox" HorizontalAlignment="Right" Height="40" Margin="20,0,10,15" 
                                        Style="{StaticResource RoundedTextBoxStyle}" FontSize="20" TextAlignment="Right" Width="500"/>
                                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" Width="565">


                                        <Button Height="46" Background="#0078D7" Foreground="White" FontSize="16" Width="168"  Click="AddPatient_Click" Margin="20,0,0,0" HorizontalAlignment="Right" >
                                            <Button.Template>
                                                <ControlTemplate TargetType="{x:Type Button}">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="#0078D7" BorderThickness="1" CornerRadius="10">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="اضافة" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Height="47" Background="#FFD73B00" Foreground="White" FontSize="16" Width="165"  Click="DeletePatient_Click" HorizontalAlignment="Right" Margin="10,0,0,0" >
                                            <Button.Template>
                                                <ControlTemplate TargetType="{x:Type Button}">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="#0078D7" BorderThickness="1" CornerRadius="10">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="حذف" Margin="0,0,10,0" VerticalAlignment="Center"/>

                                            </StackPanel>



                                        </Button>

                                        <Button Height="46" Background="#FF00D7D2" Foreground="White" FontSize="16" Width="170"  Click="UpdatePatient_Click" Margin="15,0,0,0" >
                                            <Button.Template>
                                                <ControlTemplate TargetType="{x:Type Button}">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="#0078D7" BorderThickness="1" CornerRadius="10">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="تعديل" Margin="0,0,10,0" VerticalAlignment="Center"/>

                                            </StackPanel>
                                        </Button>




                                    </WrapPanel>
                                    <WrapPanel Orientation="Horizontal" Width="299" Height="69" Margin="200,100,0,0" HorizontalAlignment="Right">

                                        <Button Height="65" Background="#FF62608E" Foreground="White" FontSize="16" Width="283"  Tag="الفحوصات" Click="OpenTab" >
                                            <Button.Template>
                                                <ControlTemplate TargetType="{x:Type Button}">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="#0078D7" BorderThickness="1" CornerRadius="10">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Width="172" TextAlignment="Center" Height="31" FontSize="20"><Run FlowDirection="RightToLeft" Language="ar-sa" Text="فحص"/></TextBlock>

                                            </StackPanel>
                                        </Button>




                                    </WrapPanel>




                                    <!-- Submit Button -->
                                </StackPanel>
                            </StackPanel>
                        </Viewbox>

                    </Grid>

                </TabItem>

                <TabItem Header="المواعيد">
                    <Grid Background="White">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="100"/>
                            <RowDefinition Height="500*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="776*"/>

                            <ColumnDefinition Width="450*"/>
                        </Grid.ColumnDefinitions>

                        <!-- DataGrid on the Left -->

                        <Viewbox Stretch="Fill" Margin="39,27,10,10" Grid.Row="1">
                            <ScrollViewer Width="788" Height="822" >
                                <StackPanel x:Name="mystack_" Background="#FFF7F7F7" RenderTransformOrigin="0.5,0.5">
                                    <StackPanel.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform/>
                                            <SkewTransform AngleY="-0.201"/>
                                            <RotateTransform/>
                                            <TranslateTransform Y="-0.996"/>
                                        </TransformGroup>
                                    </StackPanel.RenderTransform>
                                </StackPanel>

                            </ScrollViewer>

                        </Viewbox>

                        <Viewbox Stretch="Uniform" Margin="10,45,4,0" OpacityMask="White" Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" Height="764">
                            <!-- Form on the Right -->
                            <StackPanel x:Name="stackPanelappointments" Grid.Column="1" Height="532" Width="610" Background="#FFD7E7F3" ClipToBounds="{Binding Background, ElementName=stackPanel}" >

                                <TextBlock Text="إضافة موعد" FontSize="40" FontWeight="Bold" Margin="0,10,0,20" 
  Foreground="#333" HorizontalAlignment="Center" TextAlignment="Center"/>


                                <!-- patient -->
                                <TextBlock Text="المريض" FontSize="20" Foreground="#666" Margin="0,0,10,5" 
  HorizontalAlignment="Right" TextAlignment="Right"/>
                                <ComboBox x:Name="patientComboBox" SelectedIndex="-1" DataContext="{Binding pat_viewModel}" ItemsSource="{Binding Patients}" HorizontalAlignment="Right" Height="40" Margin="20,0,10,15" Width="494" FontSize="20"/>
                                <TextBlock Text="الطبيب" FontSize="20" Foreground="#666" Margin="0,0,10,5" 
HorizontalAlignment="Right" TextAlignment="Right"/>
                                <ComboBox x:Name="doctorComboBox" SelectedIndex="-1" DataContext="{Binding doc_viewModel}" ItemsSource="{Binding Doctros}" HorizontalAlignment="Right" Height="40" Margin="20,0,10,15" Width="494" FontSize="20"/>

                                <TextBlock Text="التاريخ" FontSize="20" Foreground="#666" Margin="0,0,10,5" 
  HorizontalAlignment="Right" TextAlignment="Right"/>
                                <DatePicker x:Name="DateOfappointemnt" HorizontalAlignment="Right" Height="40" Margin="20,0,10,15" Width="492" FontSize="20"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <materialDesign:TimePicker x:Name="apptime" Background="Black" RenderTransformOrigin="0.134,0.639"/>
                                    <TextBlock x:Name="timeOfappointemnt" Text="الوقت" FontSize="20" Foreground="#666" TextAlignment="Right" Margin="20,0,10,5" />
                                </StackPanel>

                                <TextBlock Text="الحالة" FontSize="20" Foreground="#666" Margin="0,0,10,5" 
HorizontalAlignment="Right" TextAlignment="Right"/>
                                <ComboBox x:Name="stateComboBox" HorizontalAlignment="Right" Height="40" Margin="20,0,10,15" Width="494" FontSize="20">
                                    <ComboBoxItem Content="0"/>
                                    <ComboBoxItem Content="1"/>
                                    <ComboBoxItem Content="2"/>
                                </ComboBox>

                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">


                                    <Button Height="46" Background="#0078D7" Foreground="White" FontSize="16" Width="168"  Click="AddAppointment_Click" Margin="20,0,0,0" HorizontalAlignment="Center" >
                                        <Button.Template>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="#0078D7" BorderThickness="1" CornerRadius="10">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="اضافة" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Height="47" Background="#FFD73B00" Foreground="White" FontSize="16" Width="165"  HorizontalAlignment="Center" Margin="10,0,0,0" >
                                        <Button.Template>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="#0078D7" BorderThickness="1" CornerRadius="10">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="حذف" Margin="0,0,10,0" VerticalAlignment="Center"/>

                                        </StackPanel>
                                    </Button>

                                    <Button Height="46" Background="#FF00D7D2" Foreground="White" FontSize="16" Width="155" HorizontalAlignment="Center"  Click="UpdateAppointment_Click" Margin="10,0,0,0" >
                                        <Button.Template>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="#0078D7" BorderThickness="1" CornerRadius="10">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="تعديل" Margin="0,0,10,0" VerticalAlignment="Center"/>

                                        </StackPanel>
                                    </Button>

                                </WrapPanel>

                                <!-- Submit Button -->
                            </StackPanel>
                        </Viewbox>
                        <StackPanel Background="#FFDEDEDE" Margin="39,261,72,6">
                            <TextBox TextWrapping="Wrap" Text="بحث .." Width="366" Height="30" TextAlignment="Center" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Top" TextChanged="TextBox_TextChanged"/>
                        </StackPanel>
                        <Viewbox Margin="0,50,0,16" HorizontalAlignment="Center" Stretch="Fill" Width="406">
                            <StackPanel Orientation="Horizontal" Height="34" Width="558">
                                <ComboBox x:Name="combostate" Width="120" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" BorderBrush="#FFB1B1B1" SelectionChanged="combostate_SelectionChanged">
                                    <ComboBox.Background>
                                        <LinearGradientBrush EndPoint="0,1">
                                            <GradientStop Color="#FFF0F0F0"/>
