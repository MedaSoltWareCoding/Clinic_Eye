<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Medical"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" x:Class="Medical.MainWindow"
        mc:Ignorable="d"
        Title="MainWindow" Width="1223" Height="795"
        WindowStartupLocation="CenterScreen"
       
        MinWidth="800"
        MinHeight="600" Margin="0,0,0,7">
    <Window.Resources>

        <!-- Style for Rounded TextBox -->
        <Style x:Key="RoundedTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="5" Padding="5">
                            <ScrollViewer Margin="0" x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="#f9f9f9"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="BorderBrush" Value="#dcdcdc"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Style for Rounded Button -->
        <Style x:Key="RoundedButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" 
                            CornerRadius="5"
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            Effect="{DynamicResource ShadowEffect}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="#0078D7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <!-- Shadow Effect -->
        <DropShadowEffect x:Key="ShadowEffect" BlurRadius="10" ShadowDepth="3" Color="#888"/>
    </Window.Resources>





    <Grid Background="#FF2D2D30">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="26*"/>
            <ColumnDefinition Width="76*"/>
            <ColumnDefinition Width="33*"/>
            <ColumnDefinition Width="52*"/>
            <ColumnDefinition Width="7*"/>
            <ColumnDefinition Width="18*"/>
            <ColumnDefinition Width="11*"/>
            <ColumnDefinition Width="73*"/>
            <ColumnDefinition Width="825*"/>
            <ColumnDefinition Width="0*"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>



        <!-- Sidebar Navigation -->



        <!-- Main Content Area -->



        <!-- Main Content Area -->



        <!-- Main Content Area -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Column="9" Margin="106,-4,8,0" Grid.ColumnSpan="2" >
            <StackPanel Background="#2D2D30" RenderTransformOrigin="0.5,0.5" Height="659" Width="86" VerticalAlignment="Top">
                <StackPanel.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform Angle="-0.359"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </StackPanel.RenderTransform>
                <TextBlock Text="عيادة العيون" FontWeight="Bold" Foreground="White" TextAlignment="Center" Width="88" HorizontalAlignment="Right" FontSize="15" Margin="0,0,0,20"/>

                <Button Height="59" Background="#0078D7" Foreground="White" FontSize="16" Tag="المرضى" Click="OpenTab" Width="64" Margin="0,0,0,10">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}" BorderBrush="#0078D7" BorderThickness="1" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Source="images/patient.png" Width="40" Height="30" HorizontalAlignment="Center" />
                        <TextBlock Text="المرضى" />
                    </StackPanel>
                </Button>

                <Button Height="59" Background="#0078D7" Foreground="White" FontSize="16"  Tag="المواعيد" Click="OpenTab" Width="64" Margin="0,0,0,10" >
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}" BorderBrush="#0078D7" BorderThickness="1" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Source="images/appointment.png" Width="40" Height="30"/>
                        <TextBlock Text="المواعيد"/>

                    </StackPanel>
                </Button>
                <Button Height="59" Background="#0078D7" Foreground="White" FontSize="16"  Tag="الأطباء" Click="OpenTab" Width="64" Margin="0,0,0,10">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}" BorderBrush="#0078D7" BorderThickness="1" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Source="images/doctor.png" Width="40" Height="30"/>
                        <TextBlock Text="الأطباء"/>
                    </StackPanel>
                </Button>

                <Button Height="59" Background="#0078D7" Foreground="White" FontSize="16" Tag="الأدوية" Click="OpenTab" Width="64" RenderTransformOrigin="0.516,0.559" Margin="0,0,0,10" >
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}" BorderBrush="#0078D7" BorderThickness="1" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Source="images/medicine.png" Width="40" Height="30"/>
                        <TextBlock Text="الأدوية"/>
                    </StackPanel>
                </Button>
                <Button Height="59" Background="#0078D7" Foreground="White" FontSize="16" Tag="الفحوصات" Click="OpenTab" Width="64" >
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}" BorderBrush="#0078D7" BorderThickness="1" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,0,-9">
                        <Image Source="images/examination.png" Width="40" Height="30"/>
                        <TextBlock Text="الفحوصات" FontSize="13"/>
                    </StackPanel>
                </Button>
                <Button  Height="59" Background="#0078D7" Foreground="White" FontSize="16" Tag="الملفات" Click="OpenTab" Width="64" Margin="0,10,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}" BorderBrush="#0078D7" BorderThickness="1" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Source="/images/folder.png" Width="40" Height="30"/>
                        <TextBlock Text="الملفات"/>
                    </StackPanel>
                </Button>
                <Button  Height="59" Margin="0,10,0,0" Background="#0078D7" Foreground="White" FontSize="16" Tag="التقارير" Click="OpenTab" Width="64">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}" BorderBrush="#0078D7" BorderThickness="1" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Source="images/application.png" Width="40" Height="30"/>
                        <TextBlock Text="التقارير"/>
                    </StackPanel>
                </Button>
                <Button Height="59" Background="#0078D7" Foreground="White" FontSize="16" Tag="النظارات" Click="OpenTab" Width="64" Margin="0,10,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}" BorderBrush="#0078D7" BorderThickness="1" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Source="images/sunglasses.png" Width="40" Height="30"/>
                        <TextBlock Text="النظارات"/>
                    </StackPanel>
                </Button>
                <Button Height="59" Margin="0,10,0,0" Background="#0078D7" Foreground="White" Tag="التكاليف" Click="OpenTab" Width="64">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}" BorderBrush="#0078D7" BorderThickness="1" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>

                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Source="images/budget.png" Width="40" Height="30"/>
                        <TextBlock Text="التكاليف" RenderTransformOrigin="0.589,2.563"/>
                    </StackPanel>
                </Button>



            </StackPanel>



        </ScrollViewer>
        <!-- Main Content Area -->
        <Grid Grid.Column="0" Grid.ColumnSpan="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="65*"/>
                <ColumnDefinition Width="39*"/>
                <ColumnDefinition Width="59*"/>
                <ColumnDefinition Width="55*"/>
                <ColumnDefinition Width="52*"/>
                <ColumnDefinition Width="1192*"/>
            </Grid.ColumnDefinitions>
            <TabControl x:Name="MainTabControl" TabStripPlacement="Top" Background="#F3F3F3" Margin="0,-24,-102,0" RenderTransformOrigin="0.392,0.509" Grid.ColumnSpan="7">
                <!-- Patients Tab -->
                <TabItem Header="المرضى">
                    <Grid Background="White">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="123*"/>
                            <ColumnDefinition Width="851*"/>
                            <ColumnDefinition Width="520*"/>
                        </Grid.ColumnDefinitions>

                        <!-- DataGrid on the Left -->
                        <DataGrid x:Name="PatientsDataGrid" 
                  BorderBrush="#dcdcdc" BorderThickness="1"   SelectedItem="{Binding SelectedPatient}"
                  RowBackground="White" AlternatingRowBackground="#f5f5f5"
                  ColumnHeaderHeight="30" RowHeight="40" 
                  GridLinesVisibility="None" AutoGenerateColumns="False" ItemsSource="{Binding Patients}" DataContext="{Binding pat_viewModel}"
                  SelectionMode="Single" AlternationCount="1"  FrozenColumnCount="80" ColumnWidth="5" Background="#FFF9FDFF" IsSynchronizedWithCurrentItem="True" Grid.ColumnSpan="2">
                            <DataGrid.Effect>
                                <DropShadowEffect Color="#FFCCCCCC" BlurRadius="17" Direction="700" ShadowDepth="5"/>
                            </DataGrid.Effect>
                            <DataGrid.Columns >







                                <DataGridTextColumn Header="رقم الهاتف" Binding="{Binding Phone}" Width="*"/>
                                <DataGridTextColumn Header="العنوان" Binding="{Binding Address}" Width="*"/>
                                <DataGridTextColumn Header="المكان" Binding="{Binding City}" Width="*"/>
                                <DataGridTextColumn Header="تاريخ الإزدياد" Binding="{Binding Birthday, StringFormat=yyyy-MM-dd}" Width="*"/>
                                <DataGridTextColumn Header="الجنس" Binding="{Binding Gender}" Width="*"/>
                                <DataGridTextColumn Header="العمر" Binding="{Binding Age}" Width="*"/>
                                <DataGridTextColumn Header="اللقب" Binding="{Binding FamilyName}" Width="*"/>
                                <DataGridTextColumn Header="الإسم" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="رقم" Binding="{Binding Id}" Width="*"/>

                            </DataGrid.Columns>
                        </DataGrid>

                        <Viewbox Grid.Column="2" OpacityMask="White" Margin="113,0,0,0" HorizontalAlignment="Left">
                            <!-- Form on the Right -->
                            <StackPanel x:Name="stackPanel" Grid.Column="1" Height="1719" Width="717" Background="White" ClipToBounds="{Binding Background, ElementName=stackPanel}" >

                                <Image Source="/images/pat.png" Width="507" Height="477" HorizontalAlignment="Right" Margin="0,0,50,0" Effect="{DynamicResource ShadowEffect}" />




                                <TextBlock Text="إضافة مريض" FontSize="40" FontWeight="Bold" Margin="0,10,0,20" 
                   Foreground="#333" HorizontalAlignment="Center" TextAlignment="Center"/>

                                <!-- Name -->
                                <TextBlock Text="الإسم" FontSize="30" Foreground="#666" Margin="0,0,10,5" 
                   HorizontalAlignment="Right" TextAlignment="Right"/>
                                <TextBox x:Name="NameTextBox" HorizontalAlignment="Right" Height="60" Margin="20,0,10,15" 
                 Style="{StaticResource RoundedTextBoxStyle}" FontSize="30" TextAlignment="Right" Width="664" Background="#FFF7F7F7" BorderBrush="#FF9A9A9A"/>

                                <!-- Family Name -->
                                <TextBlock Text="اللقب" FontSize="30" Foreground="#666" Margin="0,0,10,5" 
                   HorizontalAlignment="Right" TextAlignment="Right"/>
                                <TextBox x:Name="FamilyNameTextBox" Height="60" Margin="20,0,10,15" 
                 Style="{StaticResource RoundedTextBoxStyle}" FontSize="30" TextAlignment="Right" Width="664" HorizontalAlignment="Right" BorderBrush="#FF9A9A9A"/>

                                <!-- Age -->
                                <TextBlock Text="العمر" FontSize="30" Foreground="#666" Margin="0,0,10,5" 
                   HorizontalAlignment="Right" TextAlignment="Right"/>
                                <TextBox x:Name="AgeTextBox" HorizontalAlignment="Right" Height="60" Margin="20,0,10,15" 
                 Style="{StaticResource RoundedTextBoxStyle}" FontSize="30" TextAlignment="Right" Width="664" BorderBrush="#FF9A9A9A"/>

                                <!-- Gender -->
                                <TextBlock Text="الجنس" FontSize="30" Foreground="#666" Margin="0,0,10,5" 
                   HorizontalAlignment="Right" TextAlignment="Right"/>
                                <ComboBox x:Name="GenderComboBox" HorizontalAlignment="Right" Height="60" Margin="20,0,10,15" Width="664" FontSize="30" BorderBrush="Black">
                                    <ComboBoxItem Content="Male"/>
                                    <ComboBoxItem Content="Female"/>
                                </ComboBox>

                                <!-- Date of Birth -->
                                <TextBlock Text="تاريخ الإزدياد" FontSize="30" Foreground="#666" Margin="0,0,10,5" 
                   HorizontalAlignment="Right" TextAlignment="Right"/>
                                <DatePicker x:Name="DateOfBirthPicker" HorizontalAlignment="Right" Height="60" Margin="20,0,10,15" Width="664" FontSize="35">
                                    <DatePicker.BorderBrush>
                                        <LinearGradientBrush EndPoint="0.5,0" StartPoint="0.5,1">
                                            <GradientStop Color="#FFA3AEB9"/>
                                            <GradientStop Color="#FF8399A9" Offset="0.375"/>
                                            <GradientStop Color="#FF718597" Offset="0.375"/>
                                            <GradientStop Color="#FF9A9A9A" Offset="1"/>
                                        </LinearGradientBrush>
                                    </DatePicker.BorderBrush>
                                </DatePicker>

                                <!-- City -->
                                <TextBlock Text="المكان" FontSize="30" Foreground="#666" Margin="0,0,10,5" 
                   HorizontalAlignment="Right" TextAlignment="Right"/>
                                <TextBox x:Name="CityTextBox" HorizontalAlignment="Right" Height="60" Margin="20,0,10,15" 
                 Style="{StaticResource RoundedTextBoxStyle}" FontSize="30" TextAlignment="Right" Width="664" BorderBrush="#FF9A9A9A"/>

                                <!-- Address -->
                                <TextBlock Text="العنوان" FontSize="30" Foreground="#666" Margin="0,0,10,5" 
                   HorizontalAlignment="Right" TextAlignment="Right"/>
                                <TextBox x:Name="AddressTextBox" HorizontalAlignment="Right" Height="60" Margin="20,0,10,15" 
                 Style="{StaticResource RoundedTextBoxStyle}" FontSize="30" TextAlignment="Right" Width="664" BorderBrush="#FF9A9A9A"/>

                                <!-- Phone Number -->
                                <TextBlock Text="رقم الهاتف" FontSize="30" Foreground="#666" Margin="0,0,10,5" 
                   HorizontalAlignment="Right" TextAlignment="Right"/>
                                <TextBox x:Name="PhoneNumberTextBox" HorizontalAlignment="Right" Height="60" Margin="20,0,10,15" 
                 Style="{StaticResource RoundedTextBoxStyle}" FontSize="30" TextAlignment="Right" Width="664" BorderBrush="#FF9A9A9A"/>
                                <WrapPanel Orientation="Horizontal" Width="698" HorizontalAlignment="Right" Height="107">


                                    <Button Height="84" Background="#0078D7" Foreground="White" FontSize="16" Width="210"  Click="AddPatient_Click" Margin="20,0,0,0" >
                                        <Button.Template>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="#0078D7" BorderThickness="1" CornerRadius="10">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="اضافة" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="30"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Height="84" Background="#FFD73B00" Foreground="White" FontSize="16" Width="210"  Click="DeletePatient_Click" HorizontalAlignment="Center" Margin="20,0,0,0" >
                                        <Button.Template>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="#0078D7" BorderThickness="1" CornerRadius="10">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="حذف" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="30"/>

                                        </StackPanel>



                                    </Button>

                                    <Button Height="84" Background="#FF00D7D2" Foreground="White" FontSize="16" Width="210" HorizontalAlignment="Center"  Click="UpdatePatient_Click" Margin="20,0,0,0" >
                                        <Button.Template>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="#0078D7" BorderThickness="1" CornerRadius="10">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="تعديل" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="36"/>

                                        </StackPanel>
                                    </Button>




                                </WrapPanel>
                                <Button Height="84" Background="#FF26B53C" Foreground="White" FontSize="16" Width="482"  Click="FilePatientUpload_Click" >
                                    <Button.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="#0078D7" BorderThickness="1" CornerRadius="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="رفع ملفات" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="30" Width="239" TextAlignment="Center"/>
                                    </StackPanel>
                                </Button>




                            </StackPanel>
                        </Viewbox>

                    </Grid>

                </TabItem>
                <!-- Appointments Tab -->
                <TabItem Header="المواعيد">
                    <Grid Background="White">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="100"/>
                            <RowDefinition Height="500*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="776*"/>

                            <ColumnDefinition Width="450*"/>
                        </Grid.ColumnDefinitions>

                        <!-- DataGrid on the Left -->

                        <Viewbox Stretch="Fill" Margin="39,27,10,10" Grid.Row="1">
                            <ScrollViewer Width="759" Height="822" Background="White" Effect="{DynamicResource ShadowEffect}" VerticalScrollBarVisibility="Auto" >
                                <StackPanel x:Name="mystack_" Background="#FFEEFBEC" RenderTransformOrigin="0.5,0.5">
                                    <StackPanel.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform/>
                                            <SkewTransform AngleY="-0.201"/>
                                            <RotateTransform/>
                                            <TranslateTransform Y="-0.996"/>
                                        </TransformGroup>
                                    </StackPanel.RenderTransform>
                                </StackPanel>

                            </ScrollViewer>

                        </Viewbox>

                        <Viewbox Stretch="Uniform" OpacityMask="White" Grid.Column="1" Height="730" Grid.RowSpan="2">
                            <!-- Form on the Right -->
                            <StackPanel x:Name="stackPanelappointments" Grid.Column="1" Height="925" Width="528" Background="#FFFDFDFD" ClipToBounds="{Binding Background, ElementName=stackPanel}" >

                                <Image Source="/images/appointment.png" Height="206" Width="230"/>

                                <TextBlock Text="إضافة موعد" FontSize="40" FontWeight="Bold" Margin="0,10,0,20" 
  Foreground="#333" HorizontalAlignment="Center" TextAlignment="Center"/>


                                <!-- patient -->
                                <TextBlock Text="المريض" FontSize="20" Foreground="#666" Margin="0,0,10,5" 
  HorizontalAlignment="Right" TextAlignment="Right"/>
                                <ComboBox x:Name="patientComboBox" SelectedIndex="-1" DataContext="{Binding pat_viewModel}" ItemsSource="{Binding Patients}" HorizontalAlignment="Right" Height="40" Margin="20,0,10,15" Width="494" FontSize="20"/>
                                <TextBlock Text="الطبيب" FontSize="20" Foreground="#666" Margin="0,0,10,5" 
HorizontalAlignment="Right" TextAlignment="Right"/>
                                <ComboBox x:Name="doctorComboBox" SelectedIndex="-1" DataContext="{Binding doc_viewModel}" ItemsSource="{Binding Doctros}" HorizontalAlignment="Right" Height="40" Margin="20,0,10,15" Width="494" FontSize="20"/>

                                <TextBlock Text="التاريخ" FontSize="20" Foreground="#666" Margin="0,0,10,5" 
  HorizontalAlignment="Right" TextAlignment="Right"/>
                                <DatePicker x:Name="DateOfappointemnt" HorizontalAlignment="Right" Height="40" Margin="20,0,10,15" Width="492" FontSize="20"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <materialDesign:TimePicker x:Name="apptime" Background="Black" RenderTransformOrigin="0.134,0.639"/>
                                    <TextBlock x:Name="timeOfappointemnt" Text="الوقت" FontSize="20" Foreground="#666" TextAlignment="Right" Margin="20,0,10,5" />
                                </StackPanel>

                                <TextBlock Text="الحالة" FontSize="20" Foreground="#666" Margin="0,0,10,5" 
HorizontalAlignment="Right" TextAlignment="Right"/>

                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">


                                    <Button Height="46" Background="#0078D7" Foreground="White" FontSize="16" Width="168"  Click="AddAppointment_Click" Margin="20,0,0,0" HorizontalAlignment="Center" >
                                        <Button.Template>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="#0078D7" BorderThickness="1" CornerRadius="10">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="اضافة" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Height="47" Background="#FFD73B00" Foreground="White" FontSize="16" Width="165" Click="DeleteApoiment_Click"  HorizontalAlignment="Center" Margin="10,0,0,0" >
                                        <Button.Template>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="#0078D7" BorderThickness="1" CornerRadius="10">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="حذف" Margin="0,0,10,0" VerticalAlignment="Center"/>

                                        </StackPanel>
                                    </Button>

                                    <Button Height="46" Background="#FF00D7D2" Foreground="White" FontSize="16" Width="155" HorizontalAlignment="Center"  Click="UpdateAppointment_Click" Margin="10,0,0,0" >
                                        <Button.Template>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="#0078D7" BorderThickness="1" CornerRadius="10">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="تعديل" Margin="0,0,10,0" VerticalAlignment="Center"/>

                                        </StackPanel>
                                    </Button>

                                </WrapPanel>

                                <!-- Submit Button -->
                            </StackPanel>
                        </Viewbox>
                        <StackPanel Background="#FFDEDEDE" Margin="39,261,72,6">
                            <TextBox TextWrapping="Wrap" Text="بحث .." Width="366" Height="30" TextAlignment="Center" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Top" TextChanged="TextBox_TextChanged"/>
                        </StackPanel>
                        <Viewbox Margin="0,28,0,16" HorizontalAlignment="Center" Stretch="Fill" Width="698">
                            <StackPanel Orientation="Horizontal" Height="44" Width="584">
                                <ComboBox x:Name="combostate" Width="104" VerticalAlignment="Center" Margin="0,0,5,0" BorderBrush="#FFB1B1B1" SelectionChanged="combostate_SelectionChanged">
                                    <ComboBox.Background>
                                        <LinearGradientBrush EndPoint="0,1">
