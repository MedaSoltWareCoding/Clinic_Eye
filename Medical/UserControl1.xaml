<UserControl x:Class="Medical.UserControl1"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Medical"
             mc:Ignorable="d" Margin="0,5,20,5" Background="White" VerticalAlignment="Top" BorderBrush="Black" HorizontalAlignment="Right">
    <Viewbox HorizontalAlignment="Center" Stretch="Fill" Width="606" VerticalAlignment="Center" Height="106" >
        <StackPanel Name="grido" Background="White" MouseLeftButtonUp="messageshow"  MouseEnter="HoverPanel_MouseEnter" MouseLeave="HoverPanel_MouseLeave" Orientation="Horizontal" FlowDirection="RightToLeft" Height="118" Width="634" HorizontalAlignment="Left" VerticalAlignment="Center" >
            <StackPanel x:Name="tail" Width="14" Background="#FF0079EA"/>

            <Image Source="/icons8-appointment-48 (1).png" Height="38" Width="40" Margin="10,0,20,0"/>
            <StackPanel Height="67" Width="140">
                <Viewbox Height="22" Width="136" Stretch="Fill">
                    <TextBlock x:Name="name" TextWrapping="Wrap" Text="TextBlock" FontSize="16" FontWeight="Bold" Height="22" Width="136"/>
                </Viewbox>
                <StackPanel Orientation="Horizontal">
                    <Image Height="22" Width="17" Source="/icons8-phone-24.png" Margin="0,0,5,0" Opacity="0.5"/>
                    <TextBlock x:Name="phonef" TextWrapping="Wrap" Text="TextBlock" Height="22" Width="70" FontWeight="Bold" Foreground="#FFABABAB"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Image Height="22" Width="17" Source="/icons8-address-24.png" Margin="0,0,5,0" Opacity="0.495"/>
                    <TextBlock x:Name="address" TextWrapping="Wrap" Text="TextBlock" Height="22" Width="115" Foreground="#FFA0A0A0"/>
                </StackPanel>
            </StackPanel>
            <StackPanel VerticalAlignment="Center" Width="126" Height="40">
                <StackPanel Orientation="Horizontal">
                    <Image Height="22" Width="17" Source="/icons8-date-24.png" Margin="0,0,5,0"/>
                    <TextBlock x:Name="datef" TextWrapping="Wrap" Text="TextBlock" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Image Height="22" Width="17" Source="/icons8-time-24.png" Margin="0,0,5,0" Opacity="0.7"/>
                    <TextBlock x:Name="timef" TextWrapping="Wrap" Text="TextBlock" Height="22" Width="70" FontWeight="Bold" Foreground="#FF777777"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Width="174" Height="24">
                <Border x:Name="borderf" Background="LightBlue" Padding="10" CornerRadius="5" Width="82" Height="23">
                    <TextBlock x:Name="statef" TextWrapping="Wrap" Text="في الانتظار" Width="102" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" Foreground="White" Margin="0,-10,0,-10" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Height="82" Width="103" VerticalAlignment="Center">
                <Button Width="44" Background="White" BorderBrush="White" Foreground="Red" Click="approved" Height="54">
                    <StackPanel Height="40" RenderTransformOrigin="0.5,0.5" Width="34" HorizontalAlignment="Center">
                        <StackPanel.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="-1"/>
                                <SkewTransform/>
                                <RotateTransform/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </StackPanel.RenderTransform>
                        <Image Height="41" Width="26" Source="/icons8-done-64.png" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="-1"/>
                                    <SkewTransform/>
                                    <RotateTransform/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                    </StackPanel>
                </Button>
                <Button Width="44" Background="White" BorderBrush="White" Foreground="Red" Click="Button_Click" Height="54">
                    <StackPanel Height="40" RenderTransformOrigin="0.5,0.5" Width="34" HorizontalAlignment="Center">
                        <StackPanel.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="-1"/>
                                <SkewTransform/>
                                <RotateTransform/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </StackPanel.RenderTransform>
                        <Image Height="41" Width="26" Source="/icons8-delete-48.png" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="-1"/>
                                    <SkewTransform/>
                                    <RotateTransform/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                    </StackPanel>
                </Button>
            </StackPanel>

        </StackPanel>
    </Viewbox>
</UserControl>
