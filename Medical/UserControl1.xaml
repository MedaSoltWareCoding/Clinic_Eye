<UserControl x:Class="Medical.UserControl1"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Medical"
             mc:Ignorable="d" Margin="0,5,20,5" Background="#FFEEFBEC" Width="625" Height="105" VerticalAlignment="Top" BorderBrush="Black" HorizontalAlignment="Right">
    <Viewbox HorizontalAlignment="Center" Stretch="Fill" Width="604" VerticalAlignment="Center" Height="94" >
        <StackPanel Name="grido" Background="#FFE1ECE3" MouseLeftButtonUp="messageshow"   MouseEnter="HoverPanel_MouseEnter" MouseLeave="HoverPanel_MouseLeave" Orientation="Horizontal" FlowDirection="RightToLeft" Height="64" Width="650" HorizontalAlignment="Center" VerticalAlignment="Center" >
            <StackPanel.Effect>
                <DropShadowEffect 
        Color="Black" 
        BlurRadius="10" 
        Direction="320" 
        ShadowDepth="5" 
        Opacity="0.5" />
            </StackPanel.Effect>
            <StackPanel x:Name="tail" Width="14" Background="#FF0079EA"/>

            <Image Source="/images/appointment.png" Height="30" Width="71" Margin="10,0,20,0"/>
            <StackPanel Height="59" Width="140">
                <Viewbox Height="22" Width="136" Stretch="Fill">
                    <TextBlock x:Name="name" TextWrapping="Wrap" Text="TextBlock" FontSize="16" FontWeight="Bold" Height="21" Width="136"/>
                </Viewbox>
                <StackPanel Orientation="Horizontal" Height="19">
                    <Image Height="12" Width="17" Source="images/icons8-phone-24.png" Margin="0,0,5,0" Opacity="0.5"/>
                    <TextBlock x:Name="phonef" TextWrapping="Wrap" Text="TextBlock" Height="17" Width="88" FontWeight="Bold" Foreground="#FFABABAB" FontSize="10"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Height="17">
                    <Image Height="13" Width="17" Source="images/icons8-address-24.png" Margin="0,0,5,0" Opacity="0.495"/>
                    <TextBlock x:Name="address" TextWrapping="Wrap" Text="TextBlock" Height="16" Width="107" Foreground="#FFA0A0A0" FontSize="10"/>
                </StackPanel>
            </StackPanel>
            <StackPanel VerticalAlignment="Center" Width="126" Height="46">
                <StackPanel Orientation="Horizontal" Height="21">
                    <Image Height="22" Width="17" Source="/images/date.png" Margin="0,0,5,0"/>
                    <TextBlock x:Name="datef" TextWrapping="Wrap" Text="TextBlock" FontWeight="Bold" Height="16"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Height="22">
                    <Image Height="22" Width="17" Source="/images/time1.png" Margin="0,0,5,0" Opacity="0.7"/>
                    <TextBlock x:Name="timef" TextWrapping="Wrap" Text="TextBlock" Height="18" Width="79" FontWeight="Bold" Foreground="#FF777777"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Width="174" Height="24">
                <Border x:Name="borderf" Background="LightBlue" Padding="10" CornerRadius="5" Width="82" Height="23">
                    <TextBlock x:Name="statef" TextWrapping="Wrap" Text="في الانتظار" Width="102" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" Foreground="White" Margin="0,-10,0,-10" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Height="43" Width="89" VerticalAlignment="Center">
                <Button Width="44" Background="#FFDEF7D9" BorderBrush="White" Foreground="Red" Click="approved" Height="41">
                    <StackPanel Height="20" RenderTransformOrigin="0.5,0.5" Width="24" HorizontalAlignment="Center">
                        <StackPanel.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="-1"/>
                                <SkewTransform/>
                                <RotateTransform/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </StackPanel.RenderTransform>
                        <Image Height="19" Width="26" Source="images/done.png" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="-1"/>
                                    <SkewTransform/>
                                    <RotateTransform/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                    </StackPanel>
                </Button>
                <Button Width="44" Background="#FFF3E0DC" BorderBrush="White" Foreground="Red" Click="Button_Click" Height="41">
                    <StackPanel Height="20" RenderTransformOrigin="0.5,0.5" Width="34" HorizontalAlignment="Center">
                        <StackPanel.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="-1"/>
                                <SkewTransform/>
                                <RotateTransform/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </StackPanel.RenderTransform>
                        <Image Height="18" Width="22" Source="images/deleted.png" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="-1"/>
                                    <SkewTransform/>
                                    <RotateTransform/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                    </StackPanel>
                </Button>
            </StackPanel>

        </StackPanel>
    </Viewbox>
</UserControl>
